# Edenida environment template - copy to .env.local
# Never commit real secrets.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only privileged key (optional). Prefer publishable + RLS.
# Do NOT prefix with NEXT_PUBLIC_. Not required for EDE-DATA-001.
# SUPABASE_SECRET_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Integration tests (local only) — leave empty in CI unless secrets are configured
# E2E_AUTH_PASSWORD=
